POSTGRES_USER=v5si
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_DB=v5si
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Cloud URL takes precedence over POSTGRES_*; blank keeps local Docker. Never commit a real URL.
DATABASE_URL=
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
# Generate a 32-byte hexadecimal key locally; keep it stable after adding SMTP accounts.
SMTP_ENCRYPTION_KEY=
# Gmail OAuth: Web application client. Keep secrets on the backend only.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:5173/api/sender-accounts/google/callback
FRONTEND_BASE_URL=http://127.0.0.1:5173
DEMO_EMPLOYEE_PASSWORD=
DEMO_MANAGER_PASSWORD=

# Google Search via SerpAPI; backend only.
SERPAPI_API_KEY=
# Backend-only Bearer secret for POST /api/internal/jobs/:task (delivery, inbox, followups, search).
# Configure an external minute scheduler separately; setting this secret does not schedule jobs.
JOBS_SECRET=
# Render Free SMTP uses the Vercel gateway; leave REMOTE_SMTP_URL blank for local/direct SMTP.
# Use the HTTPS gateway origin only. Keep SMTP_RELAY_SECRET distinct from JOBS_SECRET.
# Gateway shares DATABASE_URL and SMTP_ENCRYPTION_KEY; never set REMOTE_SMTP_URL there.
REMOTE_SMTP_URL=
SMTP_RELAY_SECRET=
